Options -Indexes
DirectoryIndex index.html

# código das funções do servidor e arquivos internos não são servidos pelo site
RedirectMatch 404 ^/(supabase|\.git|node_modules)(/|$)
RedirectMatch 404 ^/(README\.md|package\.json)$

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=()"
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
</IfModule>
