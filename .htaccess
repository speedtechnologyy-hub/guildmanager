Options -Indexes
DirectoryIndex index.html

# código das funções do servidor e arquivos internos não são servidos pelo site
RedirectMatch 404 ^/(supabase|\.git|node_modules)(/|$)
RedirectMatch 404 ^/(README\.md|package\.json)$

# atalho: /master abre a rota oculta do GuildMaster
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^master/?$ /#/master [R=302,NE,L]
  # atalhos: /entrar (login de quem já tem conta) e /instalar (passo a passo do app)
  RewriteRule ^(entrar|acesso|login)/?$ /#/entrar [R=302,NE,L]
  RewriteRule ^instalar/?$ /#/instalar [R=302,NE,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=()"
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js .mjs
</IfModule>
